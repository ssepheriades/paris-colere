# Alias documentaire — la liste canonique pour Coolify est :
#   deploy/coolify/env.example
#
# Ne pas renommer en .env.prod (api/.env.prod existe déjà pour les défauts non secrets).

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
DEFAULT_URI=https://paris-colere.org
CORS_ALLOW_ORIGIN=^https://paris-colere\.org$
SERVER_NAME=:80
CADDY_GLOBAL_OPTIONS=auto_https off
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-port,x-forwarded-host
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?serverVersion=18&charset=utf8
ADMIN_EMAIL=
ADMIN_PASSWORD=
API_TOKEN=
