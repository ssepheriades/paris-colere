# Copier / coller dans Coolify → Environment Variables.
# Ne jamais committer de vraies valeurs.

# Symfony
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=                    # openssl rand -hex 32
DEFAULT_URI=https://paris-colere.org
CORS_ALLOW_ORIGIN=^https://paris-colere\.org$

# Derrière Traefik (Coolify). REMOTE_ADDR = faire confiance au hop immédiat.
SYMFONY_TRUSTED_PROXIES=REMOTE_ADDR
SYMFONY_TRUSTED_HEADERS=x-forwarded-for,x-forwarded-proto,x-forwarded-port,x-forwarded-host

# FrankenPHP / Caddy — HTTP seul (TLS côté Coolify)
SERVER_NAME=:80
CADDY_GLOBAL_OPTIONS=auto_https off

# PostgreSQL 18 (ressource Coolify séparée — coller l’URL générée)
# Exemple : postgresql://user:pass@host:5432/paris_colere?serverVersion=18&charset=utf8
DATABASE_URL=

# Compte admin initial (lu par app:create-admin — une fois)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Jeton Bearer des écritures /api. Vide = désactivé. openssl rand -hex 32
API_TOKEN=
