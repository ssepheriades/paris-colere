# Copier vers .env.local (non versionné) :
#   cp .env.local.example .env.local
#
# En production sur le serveur, définir aussi :
#   APP_ENV=prod
#   APP_DEBUG=0

###> symfony/framework-bundle ###
APP_SECRET=change-me-openssl-rand-hex-32
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# Adapter si le mot de passe Postgres local diffère de !ChangeMe!
# DATABASE_URL="postgresql://app:secret@127.0.0.1:5432/paris_colere?serverVersion=17&charset=utf8"
###< doctrine/doctrine-bundle ###

###> app/admin ###
ADMIN_EMAIL=admin@paris-colere.test
ADMIN_PASSWORD=admin
###< app/admin ###
