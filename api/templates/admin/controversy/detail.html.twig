{% extends '@EasyAdmin/crud/detail.html.twig' %}

{% block main %}
    {{ parent() }}

    {% form_theme keyFiguresForm 'bootstrap_5_layout.html.twig' %}
    <section class="content-panel mt-3">
        <div class="content-panel-header">
            <div class="content-panel-header-title">Chiffres clés</div>
        </div>
        <div class="content-panel-body with-padding">
            {{ form_start(keyFiguresForm) }}
                {{ form_errors(keyFiguresForm) }}
                <div id="controversy-key-figures"
                     data-index="{{ keyFiguresForm.keyFigures|length }}"
                     data-prototype="{{ _self.key_figure_row(keyFiguresForm.keyFigures.vars.prototype)|e('html_attr') }}">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Chiffre</th>
                                <th>Label</th>
                                <th>Sous-label</th>
                                <th>Priorité</th>
                                <th>Visible</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for child in keyFiguresForm.keyFigures %}
                                {{ _self.key_figure_row(child) }}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-secondary" id="add-key-figure">Ajouter un chiffre clé</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                {{ form_widget(keyFiguresForm._token) }}
            {{ form_end(keyFiguresForm, {render_rest: false}) }}
        </div>
    </section>

    {% form_theme itemsForm 'bootstrap_5_layout.html.twig' %}
    <section class="content-panel mt-3">
        <div class="content-panel-header">
            <div class="content-panel-header-title">Faits</div>
        </div>
        <div class="content-panel-body with-padding">
            {{ form_start(itemsForm) }}
                {{ form_errors(itemsForm) }}
                <div id="controversy-items"
                     data-index="{{ itemsForm.controversyItems|length }}"
                     data-prototype="{{ _self.item_rows(itemsForm.controversyItems.vars.prototype)|e('html_attr') }}">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Personnes</th>
                                <th>Titre</th>
                                <th>Description courte</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for child in itemsForm.controversyItems %}
                                {{ _self.item_rows(child) }}
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <button type="button" class="btn btn-secondary" id="add-controversy-item">Ajouter un fait</button>
                <button type="submit" class="btn btn-primary">Enregistrer</button>
                {{ form_widget(itemsForm._token) }}
            {{ form_end(itemsForm, {render_rest: false}) }}
        </div>
    </section>
    <script>
        const keyFiguresCollection = document.getElementById('controversy-key-figures');
        document.getElementById('add-key-figure').addEventListener('click', () => {
            const index = Number(keyFiguresCollection.dataset.index);
            const html = keyFiguresCollection.dataset.prototype.replace(/__key_figure__/g, String(index));
            keyFiguresCollection.querySelector('tbody').insertAdjacentHTML('beforeend', html);
            keyFiguresCollection.dataset.index = String(index + 1);
        });
        keyFiguresCollection.addEventListener('click', (event) => {
            const removeKeyFigure = event.target.closest('.js-remove-key-figure');
            if (removeKeyFigure) {
                removeKeyFigure.closest('tr').remove();
            }
        });

        const collection = document.getElementById('controversy-items');
        document.getElementById('add-controversy-item').addEventListener('click', () => {
            const index = Number(collection.dataset.index);
            const html = collection.dataset.prototype.replace(/__item__/g, String(index));
            collection.querySelector('tbody').insertAdjacentHTML('beforeend', html);
            collection.dataset.index = String(index + 1);
        });
        collection.addEventListener('click', (event) => {
            const removeItem = event.target.closest('.js-remove-item');
            if (removeItem) {
                const row = removeItem.closest('tr');
                row.nextElementSibling?.remove();
                row.remove();
                return;
            }

            const removeSource = event.target.closest('.js-remove-source');
            if (removeSource) {
                removeSource.closest('tr').remove();
                return;
            }

            const addSource = event.target.closest('.js-add-source');
            if (!addSource) {
                return;
            }

            const sources = addSource.closest('.sources');
            const index = Number(sources.dataset.index);
            const html = sources.dataset.prototype.replace(/__source__/g, String(index));
            sources.querySelector('tbody').insertAdjacentHTML('beforeend', html);
            sources.dataset.index = String(index + 1);
        });
    </script>
{% endblock %}

{% macro key_figure_row(keyFigure) %}
    <tr class="controversy-key-figure">
        <td>
            {{ form_widget(keyFigure.figure) }}
            {{ form_errors(keyFigure.figure) }}
        </td>
        <td>
            {{ form_widget(keyFigure.label) }}
            {{ form_errors(keyFigure.label) }}
        </td>
        <td>
            {{ form_widget(keyFigure.subLabel) }}
            {{ form_errors(keyFigure.subLabel) }}
        </td>
        <td>
            {{ form_widget(keyFigure.priority) }}
            {{ form_errors(keyFigure.priority) }}
        </td>
        <td>
            {{ form_widget(keyFigure.isVisible) }}
            {{ form_errors(keyFigure.isVisible) }}
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-link text-danger px-0 js-remove-key-figure">Retirer</button>
        </td>
    </tr>
{% endmacro %}

{% macro item_rows(item) %}
    <tr class="controversy-item">
        <td>
            {{ form_widget(item.date) }}
            {{ form_errors(item.date) }}
        </td>
        <td>
            {{ form_widget(item.people) }}
            {{ form_errors(item.people) }}
        </td>
        <td>
            {{ form_widget(item.title) }}
            {{ form_errors(item.title) }}
        </td>
        <td>
            {{ form_widget(item.shortDescription) }}
            {{ form_errors(item.shortDescription) }}
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-link text-danger px-0 js-remove-item">Retirer</button>
        </td>
    </tr>
    <tr class="controversy-item-sources">
        <td colspan="5">
            <div class="sources ms-4"
                 data-index="{{ item.sources|length }}"
                 data-prototype="{{ _self.source_row(item.sources.vars.prototype)|e('html_attr') }}">
                <div class="fw-semibold mb-2">Sources</div>
                {{ form_errors(item.sources) }}
                <table class="table table-sm mb-2">
                    <thead>
                        <tr>
                            <th>URL</th>
                            <th>Visible</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for source in item.sources %}
                            {{ _self.source_row(source) }}
                        {% endfor %}
                    </tbody>
                </table>
                <button type="button" class="btn btn-secondary btn-sm js-add-source">Ajouter une source</button>
            </div>
        </td>
    </tr>
{% endmacro %}

{% macro source_row(source) %}
    <tr class="controversy-source">
        <td>
            {{ form_widget(source.url) }}
            {{ form_errors(source.url) }}
        </td>
        <td>
            {{ form_widget(source.isVisible) }}
            {{ form_errors(source.isVisible) }}
        </td>
        <td class="text-end">
            <button type="button" class="btn btn-link text-danger px-0 js-remove-source">Retirer</button>
        </td>
    </tr>
{% endmacro %}
